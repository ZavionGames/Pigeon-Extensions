{
  "manifest_version": 3,
  "name": "Pigeon",
  "version": "1.2.1",
  "description": "Generate strong passwords in the browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pigeon",
